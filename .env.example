NODE_ENV=development
PORT=3000

# Usuário usado pela API em tempo de execução. Não use o usuário de migração aqui.
# Use 127.0.0.1 para manter a conexão local explícita.
DATABASE_URL="postgresql://bluecat_api:SENHA_DO_BLUECAT_API@127.0.0.1:5432/bluecat_knowledge?schema=public"

# Troque este valor antes de qualquer ambiente compartilhado/produção.
JWT_SECRET="troque-esta-chave-por-uma-chave-longa-e-aleatoria"
JWT_EXPIRES_IN_SECONDS=900
FRONTEND_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://localhost:4200"

# Necessárias somente para executar o seed localmente. Nunca versione valores reais.
SEED_PLATFORM_PASSWORD=
SEED_CLIENT_PASSWORD=
